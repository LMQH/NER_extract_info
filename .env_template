# 环境配置模板
# 复制此文件为 .env 并修改相应配置
# 环境类型: dev_env、show_env 或 prod_env
ENV_TYPE=dev_env

# 注意：域名列表配置已移至代码中（src/config/env_loader.py 的 ENV_DOMAIN_MAPPING）
# 如需修改域名映射，请直接编辑 env_loader.py 文件
# 以下配置项保留用于向后兼容，但不会被 env_loader 使用
# DEV_DOMAINS=localhost,127.0.0.1,dev.example.com
# SHOW_DOMAINS=show.example.com,demo.example.com
# PROD_DOMAINS=prod.example.com,www.example.com

# 模型基础路径（相对于项目根目录）
# 用于存储本地模型文件和ModelScope缓存
# 可以配置相对路径（相对于项目根目录）或绝对路径
# 如果不配置，默认使用项目根目录下的 model/ 目录
MODEL_PATH=model/

# 实体配置文件路径
ENTITY_CONFIG_PATH=entity_config.json

# 模型是否已存在（true/false）
# MODEL_EXISTS=true: 模型已存在，严格禁用ModelScope下载，只使用本地模型
# MODEL_EXISTS=false: 模型可能不存在，允许从ModelScope自动下载
MODEL_EXISTS=true

# DashScope API密钥（用于文本预处理功能，qwen-flash模型）
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_api_key_here

# MySQL数据库配置（用于地址补全功能）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=your_database_name
MYSQL_CHARSET=utf8mb4
MYSQL_MAX_CONNECTIONS=10
MYSQL_CONNECT_TIMEOUT=10
# 区域数据表名
MYSQL_REGION_TABLE=region_table
# 区域类型映射（可选，如果数据库中的region_type值不同，请修改以下配置）
# REGION_TYPE_PROVINCE=1001  # 省
# REGION_TYPE_CITY=1002       # 市
# REGION_TYPE_EXP_AREA=1003 # 区/县
# REGION_TYPE_STREET=1004   # 街道/镇

# Redis缓存配置（用于区域信息缓存）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600
# Redis连接超时配置（单位：秒）
REDIS_CONNECT_TIMEOUT=3
REDIS_SOCKET_TIMEOUT=3

# 业务ID配置（暂未用到）
EBUSINESS_ID=2223333

# MySQL统计数据库配置（用于API使用统计和错误日志，独立于地址补全功能的数据库）
MYSQL_STATS_HOST=localhost
MYSQL_STATS_PORT=3306
MYSQL_STATS_USER=root
MYSQL_STATS_PASSWORD=your_password_here
MYSQL_STATS_DATABASE=api_statistics
MYSQL_STATS_CHARSET=utf8mb4
MYSQL_STATS_MAX_CONNECTIONS=10
MYSQL_STATS_CONNECT_TIMEOUT=10

# API使用统计配置
# 使用统计表名
MYSQL_API_USAGE_TABLE=extract_api_usage
# 错误日志表名
MYSQL_API_ERROR_LOG_TABLE=extract_api_error_log
# 同步间隔（单位：秒，默认3600，即1小时）
API_USAGE_SYNC_INTERVAL=3600
# 同步日期偏移（默认1，即同步昨天的数据）
API_USAGE_SYNC_DAY_OFFSET=1

# 日志级别配置 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG: 记录所有详细信息(包括调试信息、模型加载详情等)
# INFO: 记录一般信息(启动状态、连接状态等) - 默认值，推荐生产环境使用
# WARNING: 只记录警告和错误
# ERROR: 只记录错误和严重错误
# CRITICAL: 只记录严重错误
# 注意: 文件日志始终记录DEBUG级别，控制台输出级别由此配置控制
LOG_LEVEL=INFO